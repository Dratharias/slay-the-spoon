  "keys": {
    "about": "StS1 key acquisition. actNum is StS1's 1-3 (StS2 act index + 1). The StS2 port follows owner decisions, see docs/review/act4-mechanics.md.",
    "requires_final_act_available": true,
    "ruby": {"source": "rest_site_option", "effect": "takes the rest site's action: no heal, no upgrade"},
    "sapphire": {"source": "chest", "effect": "alternative to the chest's relic: taking one forgoes the other"},
    "emerald": {
      "source": "marked_elite",
      "marking": "after each act's map is generated, while the Emerald is not held: one elite node, uniformly, with the map RNG",
      "reward": "an extra reward next to the elite's relic, not an alternative to it",
      "buff": {
        "applies_to": "every monster of the fight, at combat start",
        "choice": "one of the options, uniformly",
        "options": [
          {"power": "Strength", "amount": "actNum + 1"},
          {"max_hp_percent": 25, "rounding": "half_up", "heals_the_gain": true},
          {"power": "Metallicize", "amount": "2 * actNum + 2"},
          {"power": "RegenerateMonster", "amount": "1 + 2 * actNum", "note": "heals at the end of the monster's turn unless it is dying; never decrements"}
        ]
      }
    },
    "act4_requires": ["ruby", "emerald", "sapphire"]
  },
  "powers": {
    "Invincible": "Caps the owner's HP loss, counted after block, to what remains of the amount; the remainder drops by each HP loss and refills at the start of the monsters' turn. Every damage type counts, including HP loss. Priority 99.",
    "BeatOfDeath": "After the player plays a card, deals the amount as Thorns damage to the player. Stacks.",
    "PainfulStabs": "When the owner deals more than 0 non-Thorns damage after block, adds 1 Wound to the player's discard pile.",
    "Surrounded": "Player marker. Playing a card that targets one enemy turns the player toward that enemy.",
    "BackAttack": "The monster behind the player (opposite its facing) deals x1.5 damage: applied after the player's received-damage modifiers and stance, before final modifiers, rounded down."
  }
